# Copy to .env and fill in. Never commit .env. This repository is public.
HOST=127.0.0.1
PORT=8080
# Path to the SQLite file. Leave empty to keep data in memory.
DB_PATH=data/dealradar.db

# eBay Browse API (developer.ebay.com). Use a keyset made for DealRadar.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: eBay Partner Network campaign id, for commission on eBay links.
EBAY_CAMPAIGN_ID=

# Best Buy Products API (developer.bestbuy.com). Source is off in config/sources.json.
BESTBUY_API_KEY=

# Amazon Creators API (through an Amazon Associates account).
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
