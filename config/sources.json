{
  "refresh_cooldown_seconds": 60,
  "fetch_interval_minutes": 120,
  "max_items_per_fetch": 200,
  "sources": [
    {
      "id": "sample-a",
      "name": "Sample feed A",
      "adapter": "fixture",
      "enabled": true,
      "sample": true,
      "file": "fixtures/sample-a.json",
      "allowed_domains": [
        "example.com"
      ]
    },
    {
      "id": "sample-b",
      "name": "Sample feed B",
      "adapter": "fixture",
      "enabled": true,
      "sample": true,
      "file": "fixtures/sample-b.json",
      "allowed_domains": [
        "example.com"
      ]
    },
    {
      "id": "sample-responder",
      "name": "Sample responder feed",
      "adapter": "fixture",
      "enabled": true,
      "sample": true,
      "file": "fixtures/sample-responder.json",
      "allowed_domains": [
        "example.com"
      ]
    },
    {
      "id": "ebay",
      "name": "eBay",
      "adapter": "ebay",
      "enabled": true,
      "live": true,
      "cache_minutes": 10,
      "limit": 20,
      "allowed_domains": [
        "ebay.com"
      ],
      "image_domains": [
        "ebayimg.com"
      ]
    },
    {
      "id": "bestbuy",
      "name": "Best Buy",
      "adapter": "bestbuy",
      "enabled": false,
      "live": true,
      "cache_minutes": 10,
      "limit": 20,
      "allowed_domains": [
        "bestbuy.com"
      ],
      "image_domains": [
        "bbystatic.com"
      ],
      "note": "Off until the owner has read developer.bestbuy.com/legal. Its terms may not allow a price-comparison use."
    },
    {
      "id": "amazon",
      "name": "Amazon",
      "adapter": "amazon",
      "enabled": true,
      "live": true,
      "cache_minutes": 10,
      "limit": 10,
      "allowed_domains": [
        "amazon.com"
      ],
      "image_domains": [
        "media-amazon.com"
      ]
    }
  ],
  "live_searches_per_minute": 30
}
